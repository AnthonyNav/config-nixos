[
  { "key": "meta+c", "command": "editor.action.clipboardCopyAction", "when": "!terminalFocus" },
  { "key": "meta+v", "command": "editor.action.clipboardPasteAction", "when": "!terminalFocus" },
  { "key": "meta+x", "command": "editor.action.clipboardCutAction", "when": "!terminalFocus" },
  { "key": "meta+a", "command": "editor.action.selectAll", "when": "!terminalFocus" },
  { "key": "meta+z", "command": "undo", "when": "textInputFocus && !terminalFocus" },
  { "key": "meta+shift+z", "command": "redo", "when": "textInputFocus && !terminalFocus" },
  { "key": "meta+s", "command": "workbench.action.files.save", "when": "!terminalFocus" },
  { "key": "meta+shift+s", "command": "workbench.action.files.saveAs", "when": "!terminalFocus" },
  { "key": "meta+f", "command": "actions.find", "when": "!terminalFocus" },
  { "key": "meta+shift+f", "command": "workbench.action.findInFiles", "when": "!terminalFocus" },
  { "key": "meta+p", "command": "workbench.action.quickOpen", "when": "!terminalFocus" },
  { "key": "meta+shift+p", "command": "workbench.action.showCommands" },
  { "key": "meta+n", "command": "workbench.action.files.newUntitledFile", "when": "!terminalFocus" },
  { "key": "meta+o", "command": "workbench.action.files.openFile", "when": "!terminalFocus" },
  { "key": "meta+w", "command": "workbench.action.closeActiveEditor", "when": "!terminalFocus" },
  { "key": "meta+shift+w", "command": "workbench.action.closeWindow", "when": "!terminalFocus" },
  { "key": "meta+q", "command": "workbench.action.quit" },
  { "key": "meta+j", "command": "workbench.action.togglePanel" },
  { "key": "meta+left", "command": "cursorHome", "when": "editorTextFocus && !terminalFocus" },
  { "key": "meta+right", "command": "cursorEnd", "when": "editorTextFocus && !terminalFocus" },
  { "key": "meta+shift+left", "command": "cursorHomeSelect", "when": "editorTextFocus && !terminalFocus" },
  { "key": "meta+shift+right", "command": "cursorEndSelect", "when": "editorTextFocus && !terminalFocus" },
  { "key": "meta+c", "command": "workbench.action.terminal.copySelection", "when": "terminalFocus && terminalHasSelection" },
  { "key": "meta+v", "command": "workbench.action.terminal.paste", "when": "terminalFocus" },
  { "key": "meta+f", "command": "workbench.action.terminal.focusFind", "when": "terminalFocus" }
]
