* {
    background-color: @bg-col;
    text-color: @text-col;
    font: "Rubik 12";
}
window {
    width: 650px;
    border: 2px;
    border-color: @border-col;
    border-radius: 12px;
}
mainbox { children: [ inputbar, listview ]; }
inputbar { children: [ prompt, entry ]; padding: 12px; }
prompt {
    background-color: @border-col;
    text-color: @accent-text;
    padding: 6px 10px;
    border-radius: 6px;
}
entry { padding: 6px 10px; }
listview { lines: 8; columns: 1; padding: 6px 12px; }
element { padding: 8px; border-radius: 6px; }
element-text { background-color: transparent; text-color: inherit; }
element-icon { size: 24px; background-color: transparent; }
element selected { background-color: @selected-col; text-color: @text-col; }
